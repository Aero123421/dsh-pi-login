{
  "name": "@local/dsh-pi-login",
  "version": "0.1.0",
  "description": "DeepSeek HarnessのPi認証フローに設定画面のログインUIを追加",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["dist", "locale", "icon.svg", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings-models", "@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
